PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=maison_belle_dev
MONGODB_TEST_DB=maison_belle_test
JWT_SECRET=change-me-in-development
ALLOW_DEMO_SEED=false

# SMTP email delivery (leave blank until configured)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Generate a separate random secret of at least 32 characters; never reuse JWT_SECRET.
AUTH_CODE_SECRET=

# Gemini support assistant (keep the key server-side; never put it in frontend files)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_MS=20000

# Optional: set only behind a known reverse proxy; use its hop count or trusted IP/CIDR, never "true".
TRUST_PROXY=
